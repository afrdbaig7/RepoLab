{
  "name": "repolab",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first interactive engineering lab for repositories.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:control": "pnpm --filter @repolab/control dev",
    "format:check": "node scripts/check-format.mjs",
    "doctor": "pnpm --filter @repolab/cli build && node apps/cli/dist/index.js doctor",
    "lens": "node scripts/lens.mjs",
    "lens:build": "cargo build --locked && pnpm --filter @repolab/lens build",
    "lens:demo": "node scripts/demo.mjs",
    "lens:evaluate-public": "node scripts/evaluate-public.mjs",
    "package:stage": "cargo build --release --locked && node scripts/stage-package.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "release:inventory": "node scripts/release-inventory.mjs",
    "release:prepare": "node scripts/package-smoke.mjs && node scripts/release-inventory.mjs",
    "verify": "node scripts/verify.mjs",
    "learning:check": "node scripts/learning-docs/coverage.mjs --check",
    "learning:pdf": "node scripts/learning-docs/pdf.mjs"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.8.3",
    "vitest": "3.1.4"
  },
  "packageManager": "pnpm@11.20.0"
}
