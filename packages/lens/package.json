{
  "name": "@repolab/lens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": { "lens": "dist/cli.js" },
  "exports": { ".": "./dist/index.js" },
  "files": ["dist", "schemas", "bin", "README.md", "LICENSE"],
  "engines": { "node": ">=24 <25" },
